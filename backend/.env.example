# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Weather API Configuration (OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key_here
OPENWEATHER_API_KEY=your_weather_api_key_here

# Maps Platform (Geoapify or Google Maps)
MAPS_API_KEY=your_maps_api_key_here
GEOAPIFY_API_KEY=your_geoapify_key_here
GOOGLE_MAPS_API_KEY=

# Google Earth Engine (GEE) Configuration
GEE_PROJECT=your_gcp_project_id
GEE_SERVICE_ACCOUNT=your_gee_service_account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY=
GEE_KEY_FILE=

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
